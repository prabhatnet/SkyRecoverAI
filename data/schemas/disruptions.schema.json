{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyrecoverai.local/schemas/disruptions.schema.json",
  "title": "SkyRecoverAI Disruptions Dataset",
  "description": "Operational disruption events. Recommended simulation size is 30 to 80 events.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "disruption_id",
      "event_type",
      "severity",
      "root_cause",
      "flight_id",
      "affected_flights",
      "start_utc",
      "details"
    ],
    "properties": {
      "disruption_id": {
        "type": "string",
        "pattern": "^DIS-[0-9]{6}$"
      },
      "event_type": {
        "type": "string",
        "enum": [
          "Delay",
          "Cancellation",
          "Weather",
          "Crew"
        ]
      },
      "severity": {
        "type": "string",
        "enum": [
          "Low",
          "Medium",
          "High",
          "Critical"
        ]
      },
      "root_cause": {
        "type": "string",
        "enum": [
          "Weather",
          "CrewLegalLimit",
          "CrewAvailability",
          "Technical",
          "AirportRestriction",
          "ATC"
        ]
      },
      "flight_id": {
        "type": "string",
        "pattern": "^FL-[0-9]{5}$"
      },
      "affected_flights": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^FL-[0-9]{5}$"
        },
        "uniqueItems": true
      },
      "start_utc": {
        "type": "string",
        "format": "date-time"
      },
      "end_utc": {
        "type": "string",
        "format": "date-time"
      },
      "details": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "delay_minutes",
          "is_cancellation",
          "description"
        ],
        "properties": {
          "delay_minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440
          },
          "is_cancellation": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "affected_airports": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "uniqueItems": true
          },
          "compensation_hint": {
            "type": "string",
            "enum": [
              "MealOnly",
              "MealAndHotel",
              "FullRefund",
              "TravelCredit",
              "CaseByCase"
            ]
          }
        }
      }
    }
  }
}
