{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyrecoverai.local/schemas/airports.schema.json",
  "title": "SkyRecoverAI Airports Dataset",
  "description": "Master airport dataset for MVP simulations. Production target is exactly 20 airports.",
  "type": "array",
  "minItems": 20,
  "maxItems": 20,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "airport_id",
      "iata_code",
      "icao_code",
      "name",
      "city",
      "country",
      "timezone",
      "latitude",
      "longitude",
      "is_hub",
      "region"
    ],
    "properties": {
      "airport_id": {
        "type": "string",
        "pattern": "^APT-[0-9]{3}$"
      },
      "iata_code": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      },
      "icao_code": {
        "type": "string",
        "pattern": "^[A-Z]{4}$"
      },
      "name": {
        "type": "string",
        "minLength": 3
      },
      "city": {
        "type": "string",
        "minLength": 2
      },
      "country": {
        "type": "string",
        "minLength": 2
      },
      "timezone": {
        "type": "string",
        "pattern": "^[A-Za-z_]+/[A-Za-z_]+$"
      },
      "latitude": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "longitude": {
        "type": "number",
        "minimum": -180,
        "maximum": 180
      },
      "is_hub": {
        "type": "boolean"
      },
      "terminals": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      },
      "region": {
        "type": "string",
        "enum": [
          "NA",
          "EU",
          "APAC",
          "LATAM",
          "MEA"
        ]
      }
    }
  }
}
